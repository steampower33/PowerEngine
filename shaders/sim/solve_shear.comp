#version 460
#extension GL_EXT_shader_atomic_float : require

#include "../common/params.glsl"

layout(push_constant) uniform PC { uint base; uint count; float compliance; } pc;

layout(local_size_x = 256) in;

bool isFinite_f(float x) { return !isnan(x) && !isinf(x); }

void main() {
    uint t = gl_GlobalInvocationID.x;
    if (t >= pc.count) return;

    uint eidx = pc.base + t;
    if (eidx >= sim.num_edges) return;
    
    uint  i      = edges[eidx].i;
    uint  j      = edges[eidx].j;
    float rest   = edges[eidx].rest;
    float lambda = edges[eidx].lambda;

    float wi = w[i];
    float wj = w[j];
    float wsum = wi + wj;
    if (wsum == 0.0) { edges[eidx].lambda = 0.0; return; }

    vec3 pi = xp[i].xyz;
    vec3 pj = xp[j].xyz;
    
    vec3 d = pi - pj;
    float len = length(d);
    if (len < 1e-7) return;
    vec3 n = d / len;

    float dt    = sim.dt;
    float alpha = pc.compliance / (dt * dt);

    float C = len - rest;

    float denom = wsum + alpha;
    if (denom < 1e-8) denom = 1e-8;

    float dlambda = (-C - alpha * lambda) / denom;

    float newLambda = lambda + dlambda;
    if (!isFinite_f(newLambda)) newLambda = 0.0;
    edges[eidx].lambda = newLambda;

    vec3 corr = dlambda * n;
    
    if (wi > 0.0) {
        atomicAdd(delta_x[i], +wi * corr.x);
        atomicAdd(delta_y[i], +wi * corr.y);
        atomicAdd(delta_z[i], +wi * corr.z);
        atomicAdd(delta_count[i], 1u);
    }
    if (wj > 0.0) {
        atomicAdd(delta_x[j], -wj * corr.x);
        atomicAdd(delta_y[j], -wj * corr.y);
        atomicAdd(delta_z[j], -wj * corr.z);
        atomicAdd(delta_count[j], 1u);
    }
}
