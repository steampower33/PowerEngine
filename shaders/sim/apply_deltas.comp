#version 460
#include "../common/params.glsl"

layout(local_size_x = 256) in;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= sim.numVerts) return;

    float wi = w[i];
    if (wi == 0.0) return;

    uint cnt = dcount[i];
    if (cnt == 0u) return;

    vec3 add = vec3(deltaX[i], deltaY[i], deltaZ[i]) / float(cnt);
    x[i].xyz += add;
}