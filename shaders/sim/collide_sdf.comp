#version 460
#extension GL_EXT_shader_atomic_float : require

#include "../common/params.glsl"

layout(local_size_x = 256) in;

float sdf_sphere(vec3 p, vec3 center, float radius)
{
    return length(p - center) - radius;
}

vec3 normal_sphere(vec3 p, vec3 center)
{
    return normalize(p - center);
}


float sdf_ground(vec3 p, float gy)
{
    return p.y - gy;
}

vec3 normal_ground(vec3 p)
{
    return vec3(0, 1, 0);
}

void solveXPBD_Collision(
    uint id,
    vec3 p,
    float invMass,
    float C,
    vec3 grad)
{
    if (C >= 0.0) return;

    float wsum = invMass * dot(grad, grad);
    if (wsum < 1e-8) return;

    float deltaLambda = -(C) / wsum;

    vec3 corr = invMass * deltaLambda * grad;

    if (sim.friction > 0.0)
    {
        vec3 t = corr - dot(corr, grad) * grad;
        corr -= sim.friction * t;
    }
    
    atomicAdd(delta_x[id], corr.x);
    atomicAdd(delta_y[id], corr.y);
    atomicAdd(delta_z[id], corr.z);
    atomicAdd(delta_count[id], 1u);
}

void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= sim.num_particles) return;

    float w_i = w[id];
    if (w_i == 0.0) return;

    vec3 x_prev = x[id].xyz;
    vec3 x_pred = xp[id].xyz; 

    {
        float C = sdf_sphere(x_pred, sim.sphere_center.xyz, sim.sphere_radius + sim.thickness);
        if (C < 0.0)
        {
            vec3 n = normal_sphere(x_pred, sim.sphere_center.xyz);
            float wsum = w_i * dot(n, n);
            if (wsum > 1e-8)
            {
                float dl = -C / wsum;
                vec3 corr = w_i * dl * n;

                atomicAdd(delta_x[id], corr.x);
                atomicAdd(delta_y[id], corr.y);
                atomicAdd(delta_z[id], corr.z);
                atomicAdd(delta_count[id], 1u);

                x_pred += corr;
            }
        }
    }

    {
        float Cg = sdf_ground(x_pred, 0.0f + sim.thickness);
        if (Cg < 0.0)
        {
            vec3 n = normal_ground(x_pred);

            float wsum = w_i * dot(n, n);
            if (wsum > 1e-8)
            {
                float dl = -Cg / wsum;
                vec3 corr_n = w_i * dl * n;

                atomicAdd(delta_x[id], corr_n.x);
                atomicAdd(delta_y[id], corr_n.y);
                atomicAdd(delta_z[id], corr_n.z);
                atomicAdd(delta_count[id], 1u);

                x_pred += corr_n;
            }

            vec3 d = x_pred - x_prev;
            vec3 d_n = dot(d, n) * n;
            vec3 d_t = d - d_n;

            float len_t = length(d_t);
            if (len_t > 1e-6)
            {
                float dyn_mu = sim.friction;
                float static_eps = sim.thickness;

                vec3 d_t_new;
                if (len_t < static_eps)
                {
                    d_t_new = vec3(0.0);
                }
                else
                {
                    float k = max(0.0, 1.0 - dyn_mu);
                    d_t_new = d_t * k;
                }

                vec3 d_new = d_n + d_t_new;
                vec3 x_target = x_prev + d_new;

                vec3 corr_f = x_target - x_pred;

                atomicAdd(delta_x[id], corr_f.x);
                atomicAdd(delta_y[id], corr_f.y);
                atomicAdd(delta_z[id], corr_f.z);
                atomicAdd(delta_count[id], 1u);
            }
        }
    }
}
