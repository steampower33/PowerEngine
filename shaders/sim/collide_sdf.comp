#version 460

#include "../common/params.glsl"

layout(local_size_x = 256) in;

vec3 ComputeFriction(vec3 correction, vec3 relVel)
{
    float corrLen = length(correction);
    if (sim.friction <= 0.0 || corrLen <= 0.0)
        return vec3(0.0);

    vec3 n = correction / corrLen;

    vec3 tanVel = relVel - n * dot(relVel, n);
    float tanLen = length(tanVel);
    if (tanLen <= 1e-6)
        return vec3(0.0);

    float maxTanLen = corrLen * sim.friction;
    float scale = min(maxTanLen / tanLen, 1.0);

    return -tanVel * scale;
}

vec3 ComputeSDF(in SDFCollider c, vec3 p, float margin)
{
    if (c.type == 0) { // sphere
        vec3  diff = p - c.center;
        float dist = length(diff);
        float target = c.radius + margin;
        if (dist < target) {
            vec3 n = (dist > 1e-6) ? diff / dist : vec3(0.0, 1.0, 0.0);
            return n * (target - dist);
        }
        return vec3(0.0);
    }
    else if (c.type == 1) {
        float d = dot(p - c.center, c.normal);
        float target = margin;
        if (d < target) {
            return c.normal * (target - d);
        }
        return vec3(0.0);
    }

    return vec3(0.0);
}

vec3 ColliderVelocityAt(in SDFCollider c, vec3 p)
{
    return c.velocity;
}

void main()
{
    uint id = gl_GlobalInvocationID.x;
    if (id >= sim.numParticles)
        return;

    vec3 xi  = x[id].xyz;
    vec3 xpi = xp[id].xyz;
    
    float d = length(xpi - sim.sphereCenter.xyz);
    if (d < sim.sphereRadius + sim.thickness){
        vec3 p = mix(xpi, xi, sim.friction);
        vec3 r = p - sim.sphereCenter.xyz;
        float d = length(r);
        xpi = sim.sphereCenter.xyz + r * ((sim.sphereRadius + sim.thickness) / d);
    }
    if (xpi.y < sim.thickness){
        vec3 p = mix(xpi, xi, sim.friction);
        xpi = vec3(p.x, sim.thickness, p.z);
    }
