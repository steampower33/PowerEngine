#version 460
#extension GL_EXT_shader_atomic_float : require

#include "../common/params.glsl"

#define TYPE_CLOTH 0
#define TYPE_SOFTBODY 1

layout(local_size_x = 256) in;

void accumulate_delta(uint i, vec3 corr, uint count)
{
    atomicAdd(delta_x[i], corr.x);
    atomicAdd(delta_y[i], corr.y);
    atomicAdd(delta_z[i], corr.z);
    atomicAdd(delta_count[i], count);
}

vec3 coulomb_dt_rel(vec3 rel_disp, vec3 n, float dn_mag, float mu)
{
    if (mu <= 0.0 || dn_mag <= 0.0) return vec3(0.0);

    vec3 t = rel_disp - n * dot(rel_disp, n);
    float tlen = length(t);
    if (tlen < 1e-6) return vec3(0.0);

    float max_t = mu * dn_mag;

    float s = min(1.0, max_t / tlen);
    return -t * s;
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= sim.num_particles) return;

    float wi = w[i];
    if (wi == 0.0) return;

    vec3 xi  = xp[i].xyz;
    vec3 pxi = x[i].xyz;

    uint maxN = sim.max_neighbors;
    float r   = sim.collision_radius;
    uint base = i * maxN;

    float dt = sim.dt;

    vec3 delta_i = vec3(0.0);
    uint count_i = 0u;

    uint object_i = collision_masks[i].object_id;

    for (uint k = 0; k < maxN; ++k)
    {
        uint idx = base + k;
        uint j   = neighbors[idx];
        if (j == 0xFFFFFFFFu) break;

        float wj = w[j];
        if (wj == 0.0) continue;

        uint object_j = collision_masks[j].object_id;
        bool same = (object_i == object_j);

        bool sameSoftbody = same && (collision_masks[j].object_type == TYPE_SOFTBODY);
        if (sameSoftbody) continue;

        float compliance  = same ? pc.solve.compliance : 0.0;
        float mu          = same ? sim.neighbor_friction : sim.friction;
        float alpha_tilde = compliance / (dt * dt);

        vec3 xj  = xp[j].xyz;
        vec3 pxj = x[j].xyz;

        vec3 d = xi - xj;
        float d2 = dot(d, d);
        if (d2 < 1e-12) continue;

        float dist = sqrt(d2);
        float C = dist - r;
        if (C >= 0.0) continue;

        vec3 n = d / dist;
        float wsum = wi + wj;
        if (wsum <= 0.0) continue;

        float lambda_old = same ? neighbor_lambdas[idx] : 0.0;

        float denom = wsum + alpha_tilde;
        if (denom < 1e-8) denom = 1e-8;

        float rhs = C + alpha_tilde * lambda_old;
        float dLambda = -rhs / denom;

        float lambda_new = max(0.0, lambda_old + dLambda);
        dLambda = lambda_new - lambda_old;
        neighbor_lambdas[idx] = lambda_new;

        vec3 corr_i =  wi * dLambda * n * sim.self_collision_stiffness;
        vec3 corr_j = -wj * dLambda * n * sim.self_collision_stiffness;

        vec3 disp_i = xi - pxi;
        vec3 disp_j = xj - pxj;
        vec3 rel_disp = disp_i - disp_j;

        float dn_mag = abs(dot(corr_i - corr_j, n));

        vec3 dt_rel = coulomb_dt_rel(rel_disp, n, dn_mag, mu);

        vec3 fric_i =  (wi / wsum) * dt_rel;
        vec3 fric_j = -(wj / wsum) * dt_rel;

        delta_i += (corr_i + fric_i);
        count_i += 1u;

        accumulate_delta(j, (corr_j + fric_j), 1u);
    }

    if (count_i > 0u) {
        accumulate_delta(i, delta_i, count_i);
    }
}
