#version 460
#include "../common/params.glsl"

layout(local_size_x = 256) in;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= sim.numParticles) return;

    if (w[i] == 0.0) {
        xPrev[i] = x[i];
        return;
    }

    vec3 newV = (x[i].xyz - xPrev[i].xyz) / sim.dt;
    newV *= (1.0 - sim.damping);
    v[i].xyz = newV;

    xPrev[i] = x[i];
}