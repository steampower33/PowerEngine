#version 460
#include "../common/params.glsl"

layout(local_size_x = 256) in;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= sim.numParticles) return;

    if (w[i] == 0.0) {
        xPrev[i] = x[i];
        return;
    }

    vec3 newV = (x[i].xyz - xPrev[i].xyz) / sim.dt;
//    v[i].xyz = newV * (1.0 - 0.02);
    v[i].xyz = newV;
}