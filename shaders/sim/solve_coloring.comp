#version 460

#include "../common/params.glsl"

layout(push_constant) uniform PC { uint base; uint count; } pc;

layout(local_size_x = 256) in;
void main() {
    uint t = gl_GlobalInvocationID.x;
    if (t >= pc.count) return;

    uint eidx = pc.base + t;
    Edge e = edges[eidx];

    uint i = e.i;
    uint j = e.j;

    float w0 = w[i];
    float w1 = w[j];
    float wsum = w0 + w1;
    if (wsum == 0.0) return;

    vec3 p0 = x[i].xyz;
    vec3 p1 = x[j].xyz;

    vec3 d = p1 - p0;
    float l = length(d);
    if (l < 1e-7) return;
    vec3 n = d / l;

    float l0 = e.rest;
    float C  = l - l0;

    vec3 corr = (C / wsum) * n;

    if (w0 > 0.0) x[i].xyz += w0 * corr;
    if (w1 > 0.0) x[j].xyz -= w1 * corr;
}