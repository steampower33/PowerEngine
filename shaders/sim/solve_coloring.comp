#version 460
#include "../common/params.glsl"

layout(push_constant) uniform PC { uint base; uint count; float compliance; } pc;

layout(local_size_x = 256) in;

bool isFinite_f(float x) { return !isnan(x) && !isinf(x); }

void main() {
    uint t = gl_GlobalInvocationID.x;
    if (t >= pc.count) return;

    uint eidx = pc.base + t;
    if (eidx >= sim.numEdges) return;

    uint  i      = edges[eidx].i;
    uint  j      = edges[eidx].j;
    float rest   = edges[eidx].rest;
    float lambda = edges[eidx].lambda;

    float wi = w[i];
    float wj = w[j];
    float wsum = wi + wj;
    if (wsum == 0.0) { edges[eidx].lambda = 0.0; return; }

    vec3 pi = xp[i].xyz;
    vec3 pj = xp[j].xyz;

    vec3 d = pi - pj;
    float len = length(d);
    if (len < 1e-7) return;
    vec3 n = d / len;

    float dt    = sim.dt;
    float alpha = pc.compliance / (dt * dt);

    float C = len - rest;

    float denom = wsum + alpha;
    if (denom < 1e-8) denom = 1e-8;

    float dLambda = (-C - alpha * lambda) / denom;

    float newLambda = lambda + dLambda;
    if (!isFinite_f(newLambda)) newLambda = 0.0;
    edges[eidx].lambda = newLambda;

    vec3 corr = dLambda * n;

    if (wi > 0.0) xp[i].xyz += wi * corr;
    if (wj > 0.0) xp[j].xyz -= wj * corr;
}
