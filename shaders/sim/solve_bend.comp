#version 460
#extension GL_EXT_shader_atomic_float : require

#include "../common/params.glsl"

layout(local_size_x = 256) in;

bool isFinite_f(float x){ return !isnan(x) && !isinf(x); }
float safeLen(in vec3 v){ float l = length(v); return (l < 1e-8) ? 1e-8 : l; }

void accumulate_delta(uint i, vec3 corr)
{
    atomicAdd(delta_x[i], corr.x);
    atomicAdd(delta_y[i], corr.y);
    atomicAdd(delta_z[i], corr.z);
    atomicAdd(delta_count[i], 1u);
}

void main(){
    uint t = gl_GlobalInvocationID.x;
    if (t >= pc.solve.count) return;

    uint cidx = pc.solve.base + t;
    if (cidx >= sim.num_bends) return;

    Bend bc = bends[cidx];
    uint i0 = bc.i0, i1 = bc.i1, i2 = bc.i2, i3 = bc.i3;
    float rest = bc.rest_angle;
    float lam  = bc.lambda;

    float w0 = w[i0], w1 = w[i1], w2 = w[i2], w3 = w[i3];
    if (w0 + w1 + w2 + w3 == 0.0) {
        bends[cidx].lambda = 0.0;
        return;
    }

    vec3 x0 = xp[i0].xyz;
    vec3 x1 = xp[i1].xyz;
    vec3 x2 = xp[i2].xyz;
    vec3 x3 = xp[i3].xyz;

    vec3 px0 = x[i0].xyz;
    vec3 px1 = x[i1].xyz;
    vec3 px2 = x[i2].xyz;
    vec3 px3 = x[i3].xyz;

    vec3 e   = x1 - x0;
    float el = safeLen(e);
    vec3 ehat = e / el;

    vec3 n1 = normalize(cross(x1 - x0, x2 - x0));
    vec3 n2 = normalize(cross(x1 - x0, x3 - x0));

    float c = clamp(dot(n1, n2), -1.0, 1.0);
    float s = dot(ehat, cross(n1, n2));
    float phi = atan(s, c);

    float C = phi - rest;

    float A1 = safeLen(cross(x1 - x0, x2 - x0));
    float A2 = safeLen(cross(x1 - x0, x3 - x0));

    vec3 q2 = (cross(x1 - x0, n2) + cross(n1, x1 - x0) * c) / A1;
    vec3 q3 = (cross(x1 - x0, n1) + cross(n2, x1 - x0) * c) / A2;
    vec3 q1 = -(cross(x2 - x0, n2) + cross(n1, x2 - x0) * c) / A1
              -(cross(x3 - x0, n1) + cross(n2, x3 - x0) * c) / A2;
    vec3 q0 = -q1 - q2 - q3;

    float dt = sim.dt;

    float alpha_tilde = pc.solve.compliance / (dt * dt);

    float wsum_grad =
        w0 * dot(q0, q0) +
        w1 * dot(q1, q1) +
        w2 * dot(q2, q2) +
        w3 * dot(q3, q3);

    float denom = wsum_grad + alpha_tilde;
    if (denom < 1e-8) denom = 1e-8;

    float rhs = C + alpha_tilde * lam;
    float dlambda = -rhs / denom;

    float newLam = lam + dlambda;
    if (!isFinite_f(newLam)) newLam = 0.0;
    bends[cidx].lambda = newLam;

    vec3 corr0 =  w0 * dlambda * q0 * sim.bend_stiffness;
    vec3 corr1 =  w1 * dlambda * q1 * sim.bend_stiffness;
    vec3 corr2 =  w2 * dlambda * q2 * sim.bend_stiffness;
    vec3 corr3 =  w3 * dlambda * q3 * sim.bend_stiffness;

    if (w0 > 0.0) accumulate_delta(i0, corr0);
    if (w1 > 0.0) accumulate_delta(i1, corr1);
    if (w2 > 0.0) accumulate_delta(i2, corr2);
    if (w3 > 0.0) accumulate_delta(i3, corr3);
    
}
