#version 460
#extension GL_EXT_shader_atomic_float : require

#include "../common/params.glsl"

layout(local_size_x = 256) in;

void accumulate_delta(uint i, vec3 corr)
{
    atomicAdd(delta_x[i], corr.x);
    atomicAdd(delta_y[i], corr.y);
    atomicAdd(delta_z[i], corr.z);
    atomicAdd(delta_count[i], 1u);
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint N = sim.num_particles;
    if (i >= N) return;

    float wi = w[i];
    vec3  xi      = xp[i].xyz;
    vec3  xi_prev = x[i].xyz;

    uint maxN = sim.max_neighbors;
    float r   = sim.collision_radius;
    float r2  = r * r;

    uint base = i * maxN;

    float dt = sim.dt;
    float alpha_tilde = pc.solve.compliance / (dt * dt);
    float beta        = pc.solve.beta;
    float beta_tilde  = dt * dt * beta;
    float gamma       = (alpha_tilde * beta_tilde) / dt;

    for (uint k = 0; k < maxN; ++k)
    {
        uint idx = base + k;
        uint j   = neighbors[idx];

        if (j == 0xFFFFFFFFu)
            break;

        float wj = w[j];
        if (wi + wj == 0.0)
            continue;

        vec3 xj      = xp[j].xyz;
        vec3 xj_prev = x[j].xyz;

        vec3 d  = xi - xj;
        float d2 = dot(d, d);
        if (d2 < 1e-12)
            continue;

        float dist = sqrt(d2);

        float C = dist - r;

        if (C >= 0.0)
            continue;

        vec3 n = d / dist;

        float wsum_grad = wi + wj;

        vec3 dpi = xi - xi_prev;
        vec3 dpj = xj - xj_prev;
        float rel = dot(n, dpi) - dot(n, dpj);

        float lambda_old = neighbor_lambdas[idx];

        float denom = (1.0 + gamma) * wsum_grad + alpha_tilde;
        if (denom < 1e-8)
            continue;

        float rhs = C + alpha_tilde * lambda_old + gamma * rel;
        float dLambda = -rhs / denom;
        float lambda_new = lambda_old + dLambda;

        neighbor_lambdas[idx] = lambda_new;

        vec3 corr_i =  wi * dLambda * n;
        vec3 corr_j = -wj * dLambda * n;

        if (wi > 0.0)
            accumulate_delta(i, corr_i);
        if (wj > 0.0)
            accumulate_delta(j, corr_j);
    }
}
