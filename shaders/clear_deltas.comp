#version 460
layout(local_size_x = 256) in;

#include "common/params.glsl"

void main(){
  uint i = gl_GlobalInvocationID.x;
  if (i >= params.numParticles) return;

  // uint로 평탄화된 delta (x,y,z,w) 전부 0 세팅
  uint base = i * 4u;
  deltaU32[base + 0u] = 0u;
  deltaU32[base + 1u] = 0u;
  deltaU32[base + 2u] = 0u;
  deltaU32[base + 3u] = 0u;

  // 적용 횟수 카운터 초기화
  dcount[i] = 0u;
}
