#version 460
layout(local_size_x = 256) in;

#include "common/params.glsl"

void main(){
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.numParticles) return;

    // 고정점은 스킵
    if (w[i] == 0.0) return;

    uint base = i * 4u;
    vec3 d = vec3(
        uintBitsToFloat(deltaU32[base + 0u]),
        uintBitsToFloat(deltaU32[base + 1u]),
        uintBitsToFloat(deltaU32[base + 2u])
    );

    uint cnt = dcount[i];
    if (cnt > 0u) {
        vec3 step = d / float(cnt);

        // 이동 상한 (장면 스케일에 맞춰 튜닝: 5cm 예시)
        float cap = 0.05;
        float m = length(step);
        if (m > cap) step *= cap / m;

        xp[i].xyz += step;
    }
}
