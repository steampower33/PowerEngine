#version 460
#extension GL_EXT_shader_atomic_float : require

#include "../common/simulation_common.glsl"

layout(local_size_x = 256) in;

void accumulate_delta(uint i, vec3 corr)
{
    atomicAdd(delta_x[i], corr.x);
    atomicAdd(delta_y[i], corr.y);
    atomicAdd(delta_z[i], corr.z);
    atomicAdd(delta_count[i], 1u);
}

void main()
{
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.solve.count) return;

    uint eidx = pc.solve.base + gid;
    if (eidx >= sim.num_edges) return;

    uint  i    = edges[eidx].i;
    uint  j    = edges[eidx].j;
    float rest = edges[eidx].rest;

    float wi = w[i];
    float wj = w[j];
    float wsum = wi + wj;
    if (wsum == 0.0) return;

    vec3 xi = xp[i].xyz;
    vec3 xj = xp[j].xyz;

    vec3 d = xi - xj;
    float len = length(d);
    if (len < 1e-7) return;

    vec3 n = d / len;

    float dt = sim.dt;
    float alpha = pc.solve.compliance / (dt * dt);

    float C = len - rest;

    float denom = wsum + alpha;
    if (denom < 1e-12) return;

    float s = -C / denom;

    if (wi > 0.0) accumulate_delta(i,  n * (s * wi));
    if (wj > 0.0) accumulate_delta(j, -n * (s * wj));
}
