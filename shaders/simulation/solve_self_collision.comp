#version 460
#extension GL_EXT_shader_atomic_float : require

#include "../common/simulation_common.glsl"

#define TYPE_CLOTH    0u
#define TYPE_SOFTBODY 1u

layout(local_size_x = 256) in;

void accumulate_delta(uint i, vec3 corr)
{
    atomicAdd(delta_x[i], corr.x);
    atomicAdd(delta_y[i], corr.y);
    atomicAdd(delta_z[i], corr.z);
    atomicAdd(delta_count[i], 1u);
}

bool isFinite_f(float x){ return !isnan(x) && !isinf(x); }

// PBD/XPBD-style friction approximation:
// clamp tangential relative displacement based on normal correction magnitude.
// This is NOT a full Coulomb cone solve.
vec3 friction_clamp(vec3 rel_disp, vec3 n, float dn, float mu)
{
    if (mu <= 0.0 || dn <= 0.0) return vec3(0.0);

    vec3 t  = rel_disp - n * dot(rel_disp, n);
    float tl = length(t);
    if (tl < 1e-7) return vec3(0.0);

    float max_t = mu * dn;              // tangential displacement limit
    float s = min(1.0, max_t / tl);
    return -t * s;                      // oppose tangential motion
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.solve.count) return;

    float wi = w[i];
    if (wi == 0.0) return;

    // Only cloth participates in self-collision in this pass
    if (collision_masks[i].object_type != TYPE_CLOTH) return;

    uint obj_i = collision_masks[i].object_id;

    uint maxN = sim.max_neighbors;
    uint base = i * maxN;

    float r  = sim.collision_radius;
    float r2 = r * r;

    float dt = sim.dt;

    float alpha_tilde = pc.solve.compliance / (dt * dt);

    float stiffness = pc.solve.stiffness;
    float mu        = sim.neighbor_friction;

    vec3 xi  = xp[i].xyz;
    vec3 pxi = x[i].xyz;

    vec3 sumCorr = vec3(0.0);
    uint sumCount = 0u;

    for (uint k = 0; k < maxN; ++k)
    {
        uint idx = base + k;
        uint j   = neighbors[idx];
        if (j == 0xFFFFFFFFu) break;

        float wj = w[j];
        if (wj == 0.0) continue;

        // same object only
        if (collision_masks[j].object_id != obj_i) continue;

        // cloth only
        if (collision_masks[j].object_type != TYPE_CLOTH) continue;

        vec3 xj  = xp[j].xyz;
        vec3 pxj = x[j].xyz;

        vec3 d = xi - xj;
        float d2 = dot(d, d);
        if (d2 < 1e-12) continue;

        if (d2 >= r2) continue;

        float dist = sqrt(d2);
        vec3  n = d / dist;

        float C = dist - r;
        if (C >= 0.0) continue;

        float wsum = wi + wj;
        if (wsum <= 0.0) continue;

        float lam_old = neighbor_lambdas[idx];

        float denom = wsum + alpha_tilde;
        denom = max(denom, 1e-8);

        float rhs = C + alpha_tilde * lam_old;
        float dLam = -rhs / denom;

        float lam_new = max(0.0, lam_old + dLam * stiffness);
        dLam = lam_new - lam_old;

        float safeLam = isFinite_f(lam_new) ? lam_new : 0.0;
        neighbor_lambdas[idx] = safeLam;

        vec3 corr_i =  (wi * dLam) * n;
        vec3 corr_j = -(wj * dLam) * n;

        vec3 disp_i = xi - pxi;
        vec3 disp_j = xj - pxj;
        vec3 rel_disp = disp_i - disp_j;

        float dn = abs(wsum * dLam);

        vec3 fric = friction_clamp(rel_disp, n, dn, mu);

        vec3 fric_i =  (wi / wsum) * fric;
        vec3 fric_j = -(wj / wsum) * fric;

        vec3 out_i = (corr_i + fric_i);
        vec3 out_j = (corr_j + fric_j);

        sumCorr += out_i;
        sumCount += 1u;

        accumulate_delta(j, out_j);
    }
    
    atomicAdd(delta_x[i], sumCorr.x);
    atomicAdd(delta_y[i], sumCorr.y);
    atomicAdd(delta_z[i], sumCorr.z);
    atomicAdd(delta_count[i], sumCount);
}
