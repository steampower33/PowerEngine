#version 460
#include "../common/simulation_common.glsl"

layout(local_size_x = 256) in;

float sdf_sphere(vec3 p, vec3 center, float radius) {
    return length(p - center) - radius;
}
vec3 normal_sphere(vec3 p, vec3 center) {
    vec3 d = p - center;
    float l = length(d);
    return (l > 1e-8) ? (d / l) : vec3(0.0, 1.0, 0.0);
}

float sdf_plane(vec3 p, vec3 pointOnPlane, vec3 n) {
    return dot(n, p - pointOnPlane);
}
vec3 normal_plane(vec3 n) { return n; }

float sdf_capsule(vec3 p, vec3 a, vec3 b, float r) {
    vec3 pa = p - a;
    vec3 ba = b - a;
    float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-8), 0.0, 1.0);
    vec3 q = a + h * ba;
    return length(p - q) - r;
}
vec3 normal_capsule(vec3 p, vec3 a, vec3 b) {
    vec3 ba = b - a;
    float h = clamp(dot(p - a, ba) / max(dot(ba, ba), 1e-8), 0.0, 1.0);
    vec3 q = a + h * ba;
    vec3 d = p - q;
    float l = length(d);
    return (l > 1e-8) ? (d / l) : vec3(0.0, 1.0, 0.0);
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.solve.count) return;
    uint id = pc.solve.base + gid;

    if (w[id] == 0.0) return;

    vec3 p = xp[id].xyz;          // predicted position
    float thickness = sim.thickness;

    // "near-contact" slop (prevents micro-separation & jitter)
    const float SLOP = 1e-4;
    
    for (uint iter = 0; iter < 2; iter++)
    {
        for (uint c = 0; c < sim.num_colliders; ++c) {
            Collider col = colliders[c];
            if (col.do_collide == 0u) continue;

            int kind = col.kind;

            if (kind == 0) {
                // sphere
                float r = col.radius + thickness;
                float C = sdf_sphere(p, col.p0, r);
                if (C < 0.0) {
                    vec3 n = normal_sphere(p, col.p0);
                    p += (-C + SLOP) * n; // push out + keep a tiny gap
                }
            }
            else if (kind == 1) {
                // plane
                vec3 n = normalize(col.p1);
                // plane point is col.p0, push plane "up" by thickness
                float C = sdf_plane(p, col.p0 + n * thickness, n);

                // treat near-contact as contact to prevent creep/jitter
                if (C < SLOP) {
                    p += (SLOP - C) * n; // if penetrating, (SLOP - C) includes penetration
                }
            }
            else if (kind == 2) {
                // capsule
                float r = col.radius + thickness;
                float C = sdf_capsule(p, col.p0, col.p1, r);
                if (C < 0.0) {
                    vec3 n = normal_capsule(p, col.p0, col.p1);
                    p += (-C + SLOP) * n;
                }
            }
        }
    }
    xp[id].xyz = p;
}
