// inter_cloth_collision.comp
#version 460
#extension GL_EXT_shader_atomic_float : require

#include "../common/simulation_common.glsl"

#define TYPE_CLOTH    0u
#define TYPE_SOFTBODY 1u

layout(local_size_x = 256) in;

void accumulate_delta(uint i, vec3 corr, uint count)
{
    atomicAdd(delta_x[i], corr.x);
    atomicAdd(delta_y[i], corr.y);
    atomicAdd(delta_z[i], corr.z);
    atomicAdd(delta_count[i], count);
}

bool isFinite_f(float x){ return !isnan(x) && !isinf(x); }

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.solve.count) return;

    float wi = w[i];
    if (wi == 0.0) return;

    // Only cloth particles participate
    if (collision_masks[i].object_type != TYPE_CLOTH) return;

    uint obj_i = collision_masks[i].object_id;

    uint maxN = sim.max_neighbors;
    uint base = i * maxN;

    float r  = sim.collision_radius;  // treat as effective separation distance
    float r2 = r * r;

    float dt = sim.dt;
    float alpha_tilde = 0.0;

    float stiffness = pc.solve.stiffness;

    vec3 xi = xp[i].xyz;

    vec3 sumCorr = vec3(0.0);
    uint sumCount = 0u;

    for (uint k = 0; k < maxN; ++k)
    {
        uint idx = base + k;
        uint j = neighbors[idx];
        if (j == 0xFFFFFFFFu) break;

        float wj = w[j];
        if (wj == 0.0) continue;

        // cloth only
        if (collision_masks[j].object_type != TYPE_CLOTH) continue;

        // inter only (different objects)
        uint obj_j = collision_masks[j].object_id;
        if (obj_j == obj_i) continue;

        vec3 xj = xp[j].xyz;

        vec3 d = xi - xj;
        float d2 = dot(d, d);
        if (d2 < 1e-12) continue;

        // quick reject
        if (d2 >= r2) continue;

        float dist = sqrt(d2);
        vec3 n = d / dist;

        float C = dist - r;           // C < 0 => penetration
        if (C >= 0.0) continue;

        float wsum = wi + wj;
        if (wsum <= 0.0) continue;

        // Inter contacts: do NOT persist lambda; treat lambda_old = 0 each iteration
        float lambda_old = 0.0;

        // grad_i = n, grad_j = -n => |grad|^2 = 1
        float denom = wsum + alpha_tilde;
        denom = max(denom, 1e-8);

        float rhs = C + alpha_tilde * lambda_old;
        float dLambda = -rhs / denom;

        // Inequality: lambda >= 0 (no attraction)
        float lambda_new = max(0.0, lambda_old + dLambda * stiffness);
        dLambda = lambda_new - lambda_old;

        if (!isFinite_f(dLambda)) continue;

        // Normal correction
        vec3 corr_i =  (wi * dLambda) * n;
        vec3 corr_j = -(wj * dLambda) * n;

        // Accumulate:
        // - i: local sum (reduce atomics)
        // - j: atomic now
        sumCorr += corr_i;
        sumCount += 1u;

        accumulate_delta(j, corr_j, 1u);
    }

    if (sumCount > 0u)
    {
        accumulate_delta(i, sumCorr, sumCount);
    }
}
