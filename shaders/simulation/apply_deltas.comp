#version 460

#include "../common/simulation_common.glsl"

layout(local_size_x = 256) in;
void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.solve.count) return;
    uint i = pc.solve.base + gid;

    if (w[i] == 0.0) {
        delta_x[i] = 0.0; delta_y[i] = 0.0; delta_z[i] = 0.0; delta_count[i] = 0u;
        return;
    }
    uint c = max(delta_count[i], 1u);
    vec3 corr = vec3(delta_x[i], delta_y[i], delta_z[i]) / c;
    xp[i].xyz += corr * sim.relaxation_factor;
    
    delta_x[i]=0.0; delta_y[i]=0.0; delta_z[i]=0.0; delta_count[i]=0u;
}