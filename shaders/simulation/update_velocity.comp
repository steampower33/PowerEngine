#version 460
#include "../common/simulation_common.glsl"

layout(local_size_x = 256) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= sim.num_particles) return;

    if (w[i] == 0.0) {
        v[i] = vec4(0.0);
        x[i] = xp[i];
        return;
    }

    vec3 old_pos = x[i].xyz;
    vec3 new_pos = xp[i].xyz;
    float dt = sim.dt;

    // Ground contact check (y=0)
    const float SLOP = 1e-4;
    float groundY = 0.0 + sim.thickness + SLOP;

    bool onGround = (new_pos.y <= groundY + 5e-4); // contact band

    if (onGround) {
        // Keep it on the ground
        new_pos.y = max(new_pos.y, groundY);

        // Static-like stick: kill tiny tangent drift
        vec3 disp = new_pos - old_pos;

        // No downward motion
        if (disp.y < 0.0) disp.y = 0.0;

        // Tangential displacement damping (x,z)
        float stick = clamp(sim.friction, 0.0, 1.0); // 0=no stick, 1=full stick
        disp.x *= (1.0 - stick);
        disp.z *= (1.0 - stick);

        // Snap tiny drift to zero
        const float SNAP = 5e-4;
        if (abs(disp.x) < SNAP) disp.x = 0.0;
        if (abs(disp.z) < SNAP) disp.z = 0.0;

        new_pos = old_pos + disp;
    }

    // Velocity from final position
    vec3 raw_vel = (new_pos - old_pos) / dt;

    // Optional: if on ground and very slow, hard sleep
    if (onGround && length(raw_vel) < 0.01) {
        raw_vel = vec3(0.0);
    }

    // Clamp & damping (as you had)
    float speed = length(raw_vel);
    if (speed > sim.max_speed) {
        raw_vel *= (sim.max_speed / speed);
        new_pos = old_pos + raw_vel * dt;
    }

    vec3 damped_vel = raw_vel * (1.0 - sim.global_damping * dt);

    v[i].xyz = damped_vel;
    x[i].xyz = new_pos;
}
